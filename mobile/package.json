{
  "name": "debtout-mobile",
  "version": "0.10.0",
  "private": true,
  "description": "DebtOut para iPhone y Android (Capacitor). La app web se genera con python3 ../src/build.py.",
  "scripts": {
    "build": "python3 ../src/build.py",
    "sync": "python3 ../src/build.py && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "assets": "python3 ../src/make_native_assets.py"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@revenuecat/purchases-capacitor": "^14.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
